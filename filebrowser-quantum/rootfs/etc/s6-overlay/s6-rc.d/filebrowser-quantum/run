#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# FileBrowser Quantum 启动脚本 (S6 longrun)
# ==============================================================================
bashio::log.info "Starting FileBrowser Quantum..."

# 等待 cont-init 完成（legacy-cont-init 与 filebrowser 可能并行启动）
for _ in $(seq 1 60); do
    [ -f /run/filebrowser-initialized ] && break
    sleep 1
done
if [ ! -f /run/filebrowser-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露错误"
fi

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待 FileBrowser Quantum 服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 60); do
            if curl -s -m 2 -o /dev/null http://127.0.0.1:8080/health 2>/dev/null || (exec 3<>/dev/tcp/127.0.0.1/8080 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "FileBrowser Quantum 服务启动成功，开始清空历史子目录..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf "${p}" 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /config/.migrated_from_legacy
                bashio::log.info "存量迁移已彻底落定。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

# 设置环境变量指向配置文件
export FILEBROWSER_CONFIG="/config/config.yaml"

# 直接启动，不使用任何参数
exec /usr/local/bin/filebrowser
