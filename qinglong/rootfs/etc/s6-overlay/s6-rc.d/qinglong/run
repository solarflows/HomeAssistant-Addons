#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Qinglong 启动脚本 (S6 longrun service)
# 在 cont-init.d 完成持久化目录设置后，启动青龙面板
# ==============================================================================
bashio::log.info "Starting Qinglong..."

# 等待 cont-init 完成（legacy-cont-init 与 qinglong 可能并行启动）
for _ in $(seq 1 60); do
    [ -f /run/qinglong-initialized ] && break
    sleep 1
done
if [ ! -f /run/qinglong-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露错误"
fi

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待青龙面板服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 60); do
            if curl -s --noproxy '*' -m 2 -o /dev/null http://127.0.0.1:5700/api/health 2>/dev/null || (exec 3<>/dev/tcp/127.0.0.1/5700 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "青龙面板服务启动成功，开始清空历史子目录..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf "${p}" 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /config/.migrated
                bashio::log.info "历史子目录已彻底清空，一次性迁移完成。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

export QL_DATA_DIR=/config/data
cd /ql
exec ./docker/docker-entrypoint.sh
