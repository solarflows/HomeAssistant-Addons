#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Uptime Kuma 启动脚本 (S6 longrun)
# ==============================================================================
bashio::log.info "Starting Uptime Kuma..."

# 等待 cont-init 完成（legacy-cont-init 与 uptime-kuma 可能并行启动）
for _ in $(seq 1 60); do
    [ -f /run/kuma-initialized ] && break
    sleep 1
done
if [ ! -f /run/kuma-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露错误"
fi

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待 Uptime Kuma 服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 60); do
            if (exec 3<>/dev/tcp/127.0.0.1/3001 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "Uptime Kuma 服务启动成功，开始清空历史子目录..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf "${p}" 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /opt/uptime-kuma/data/.migrated_from_legacy
                bashio::log.info "存量迁移已彻底落定。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

cd /opt/uptime-kuma || exit 1
exec node server/server.js
