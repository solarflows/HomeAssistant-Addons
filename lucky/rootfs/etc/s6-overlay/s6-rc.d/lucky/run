#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Lucky 启动脚本 (S6 longrun)
# 在 cont-init.d 完成持久化目录设置后，启动 Lucky（前台阻塞运行）
# ==============================================================================
bashio::log.info "Starting Lucky..."

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待 Lucky 服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 60); do
            if (exec 3<>/dev/tcp/127.0.0.1/16601 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "Lucky 服务启动成功，开始清空历史子目录..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf "${p}" 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /config/.migrated
                bashio::log.info "历史子目录已彻底清空，一次性迁移完成。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

exec /usr/local/bin/lucky -c /config/lucky.conf
