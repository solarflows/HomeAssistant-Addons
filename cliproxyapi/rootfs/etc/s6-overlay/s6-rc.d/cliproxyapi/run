#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# CLIProxyAPI 启动脚本 (S6 longrun)
# ==============================================================================
bashio::log.info "Starting CLIProxyAPI..."

# 等待 cont-init 生成配置文件：S6 stage2 hook 拉起用户服务的时机可能早于
# legacy-cont-init（00-init.sh），首次启动存在竞态；最多等 30 秒。
for _ in $(seq 1 30); do
    [ -f /CLIProxyAPI/config.yaml ] && break
    sleep 1
done
if [ ! -f /CLIProxyAPI/config.yaml ]; then
    bashio::log.warning "config.yaml 仍未生成（cont-init 可能失败），继续启动以暴露错误"
fi

cd /CLIProxyAPI
exec /CLIProxyAPI/cli-proxy-api -config /CLIProxyAPI/config.yaml