#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# ADDON_SLUG 启动脚本 (S6 longrun)
# 在前台阻塞运行，S6 会自动重启崩溃的进程
# ==============================================================================
bashio::log.info "Starting ADDON_SLUG..."

# 等待 cont-init 完成（最多等待 30 秒，避免启动竞态）
for _ in $(seq 1 30); do
    [ -f /run/ADDON_SLUG-initialized ] && break
    sleep 1
done
if [ ! -f /run/ADDON_SLUG-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露潜在错误"
fi

# 前台阻塞执行主程序 (参数直接指向原生直挂路径，零软链接)
exec /usr/local/bin/app --config /app/data/config.yaml
