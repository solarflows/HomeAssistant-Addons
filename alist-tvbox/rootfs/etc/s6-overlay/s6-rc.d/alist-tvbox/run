#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# alist-tvbox 启动脚本 (S6 longrun)
# 直接控制 httpd + nginx + Java，不依赖上游 entrypoint.sh
# ==============================================================================
bashio::log.info "Starting AList-TvBox..."

APP_PID=
trap 'kill ${APP_PID} 2>/dev/null; exit 0' TERM INT

# 启动 httpd（xiaoya 模式，端口 81）
if [ -f /bin/busybox-extras ]; then
    bashio::log.info "Starting httpd on port 81..."
    /bin/busybox-extras httpd -p 81 -h /www &
fi

# 启动 nginx（先停止可能已存在的实例，避免 S6 重启时端口冲突）
bashio::log.info "Starting nginx..."
nginx -s stop 2>/dev/null || true
sleep 0.5
mkdir -p /var/cache/nginx/image
nginx || bashio::log.warning "nginx failed to start"

# 等待 cont-init 完成（legacy-cont-init 与 alist-tvbox 可能并行启动）
# 使用 /run 临时内存标记文件确保 00-init.sh 执行完毕，最多等待 60 秒
for _ in $(seq 1 60); do
    [ -f /run/atv-initialized ] && break
    sleep 1
done
if [ ! -f /run/atv-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露错误"
fi

# 确保 config 目录存在（双重保障，防止极短 race condition）
mkdir -p /data/atv/config/

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 120); do
            if (exec 3<>/dev/tcp/127.0.0.1/4567 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "AList-TvBox 服务启动成功，开始清空旧迁移数据..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf ${p} 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /config/.migrated
                bashio::log.info "旧迁移数据已彻底清空，一次性迁移完成。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

# 启动 Java 应用（前台运行，作为 S6 管理的主进程）
LOW_MEMORY=$(bashio::config 'LOW_MEMORY' 'true')
if [ "${LOW_MEMORY}" = "true" ]; then
    MEM_OPT="-Xmx512M"
else
    MEM_OPT="-Xmx1024M"
fi
bashio::log.info "AList-TvBox JVM memory: ${MEM_OPT}"
ATV_DEBUG=$(bashio::config 'ATV_DEBUG' 'false')
DEBUG_FLAG=""
if [ "${ATV_DEBUG}" = "true" ]; then
    DEBUG_FLAG="--debug"
    bashio::log.info "Debug mode enabled"
fi
cd /opt/atv
exec java ${MEM_OPT} \
    -Duser.timezone=Asia/Shanghai \
    -Datv.data.dir=/config \
    -Dspring.config.additional-location=file:/config/,file:/data/atv/config/ \
    -Dloader.main=cn.har01d.alist_tvbox.AListApplication \
    -cp application/BOOT-INF/classes:dependencies/BOOT-INF/lib/*:snapshot-dependencies/BOOT-INF/lib/*:spring-boot-loader \
    org.springframework.boot.loader.launch.PropertiesLauncher \
    81 --spring.profiles.active=production,xiaoya \
    --spring.datasource.jdbc-url=jdbc:h2:file:/config/atv \
    --spring.sql.init.data-locations=optional:file:/data/atv/data.sql,optional:file:/config/atv/data.sql ${DEBUG_FLAG}
