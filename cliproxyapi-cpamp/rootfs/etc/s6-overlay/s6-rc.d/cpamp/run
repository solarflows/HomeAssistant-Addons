#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# CPAMP Manager Server 启动脚本 (S6 longrun)
# ==============================================================================
# 说明:
#   与 CLIProxyAPI 同容器运行，通过 loopback 连接 CPA (:8317)。
#   - CPA 管理密钥 / CPAMP 管理员密钥均由 00-init.sh 准备（生成 + 回填 HA 选项），
#     此处仅读取注入；S6 服务拉起与 cont-init 存在启动竞态，先等待文件就绪。
# ==============================================================================
set -e

bashio::log.info "Starting CPAMP Manager Server..."

export HTTP_ADDR="0.0.0.0:18317"
export USAGE_DATA_DIR="/config/cpamp"
export USAGE_DB_PATH="/config/cpamp/usage.sqlite"
export CPA_MANAGER_DATA_KEY_PATH="/config/cpamp/data.key"
export USAGE_COLLECTOR_MODE="auto"

# 等待 cont-init 完成（最多 60 秒，消除启动竞态）
for _ in $(seq 1 60); do
    [ -f /run/cpamp-initialized ] && break
    sleep 1
done
if [ ! -f /run/cpamp-initialized ]; then
    bashio::log.warning "00-init.sh 仍未完成或超时，继续启动以暴露错误"
fi

# 确认服务启动成功后，清空旧迁移数据并固化一次性迁移标记
if [ -f /run/migration_cleanup_pending ]; then
    (
        bashio::log.info "等待 CPAMP 服务启动成功以完成迁移后旧目录清理..."
        for _ in $(seq 1 60); do
            if curl -s -m 2 -o /dev/null http://127.0.0.1:18317/health 2>/dev/null || (exec 3<>/dev/tcp/127.0.0.1/18317 && exec 3>&-) 2>/dev/null; then
                bashio::log.info "CPAMP 服务启动成功，开始清空历史子目录..."
                CLEANUP_PATHS=$(cat /run/migration_cleanup_pending)
                for p in ${CLEANUP_PATHS}; do
                    rm -rf "${p}" 2>/dev/null || true
                done
                rm -f /run/migration_cleanup_pending
                touch /config/.migrated_from_legacy
                bashio::log.info "存量迁移已彻底落定。"
                break
            fi
            sleep 2
        done
    ) >/dev/null 2>&1 &
fi

# CPA 连接（同容器 loopback；无密钥时留待面板首次设置）
export CPA_UPSTREAM_URL="http://127.0.0.1:8317"
if [ -s /config/management_key.txt ]; then
    CPA_MANAGEMENT_KEY="$(cat /config/management_key.txt)"
    export CPA_MANAGEMENT_KEY
else
    bashio::log.warning "management_key.txt 不存在，CPAMP 将以未连接状态启动（可在面板中手动配置）"
fi

# CPAMP 管理员密钥：选项 > 持久化文件（均由 00-init.sh 维护）
ADMIN_KEY=$(bashio::config 'CPAMP_ADMIN_KEY' '')
KEY_FILE="/config/cpamp_admin_key.txt"
if [ -z "${ADMIN_KEY}" ] && [ -s "${KEY_FILE}" ]; then
    ADMIN_KEY="$(cat "${KEY_FILE}")"
fi
if [ -z "${ADMIN_KEY}" ]; then
    bashio::log.warning "CPAMP 管理员密钥缺失（选项与文件均为空），将由 CPAMP 自行生成（见其日志）"
fi
export CPA_MANAGER_ADMIN_KEY="${ADMIN_KEY}"

exec /usr/local/bin/cpa-manager-plus
